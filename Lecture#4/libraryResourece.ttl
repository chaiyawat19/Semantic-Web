@base <http://www.libraryresource.org/> .
@prefix sc: <https://schema.org/> .
@prefix dc:<http://purl.org/metadata/dublin-core#> .
@prefix xs: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .


# Libraryresource Classes

<Libraryresource> a rdfs:Class .

<MediaObject> a rdfs:Class;
    rdfs:subClassOf <Libraryresource> .

<Book> a rdfs:Class;
    rdfs:subClassOf <Libraryresource> .

<Video> a rdfs:Class;
    rdfs:subClassOf <MediaObject> .

<Audio> a rdfs:Class;
    rdfs:subClassOf <MediaObject> .

<Image> a rdfs:Class;
    rdfs:subClassOf <MediaObject> .


# Organization Classes
<Organization> a rdfs:Class .

<Company> a rdfs:Class;
    rdfs:subClassOf <Organization> .

<Producer> a rdfs:Class;
    rdfs:subClassOf <Company> .

<Publisher> a rdfs:Class;
    rdfs:subClassOf <Company> .


# Person Classes
<Person> a rdfs:Class .

<Author> a rdfs:Class;
    rdfs:subClassOf <Person> .

<MediaDesigner> a rdfs:Class;
    rdfs:subClassOf <Person> .


# LibraryResource Property
dc:title a rdf:Property;
    rdfs:domain <Libraryresource>;
    rdfs:range xs:string .

dc:description a rdf:Property;
    rdfs:domain <Libraryresource>;
    rdfs:range xs:string .

# MediaObject Property
sc:producer a rdf:Property;
    rdfs:domain <MediaObject>;
    rdfs:range <Producer> .

sc:encodingFormat a rdf:Property;
    rdfs:domain <MediaObject>;
    rdfs:range xs:string .

sc:size a rdf:Property;
    rdfs:domain <MediaObject>;
    rdfs:range xs:integer .

dc:creator a rdf:Property;
    rdfs:domain <MediaObject>;
    rdfs:range <MediaDesigner> .

# Image Property
sc:width a rdf:Property;
    rdfs:domain <Image>;
    rdfs:range xs:decimal .

sc:height a rdf:Property;
    rdfs:domain <Image>;
    rdfs:range xs:decimal .

# Book Property
sc:isbn a rdf:Property;
    rdfs:domain <Book>;
    rdfs:range xs:string .

sc:genre a rdf:Property;
    rdfs:domain <Book>;
    rdfs:range xs:string .

sc:publisher a rdf:Property;
    rdfs:domain <Book>;
    rdfs:range <Publisher> .

sc:creator a rdf:Property;
    rdfs:domain <Book>;
    rdfs:range <Author> .

sc:price a rdf:Property;
    rdfs:domain <Book>;
    rdfs:range xs:decimal .

# Organization Property
sc:name a rdf:Property;
    rdfs:domain <Organization>;
    rdfs:range xs:string .

sc:address a rdf:Property;
    rdfs:domain <Organization>;
    rdfs:range xs:string .

# Person Property
sc:givenName a rdf:Property;
    rdfs:domain <Person>;
    rdfs:range xs:string .

sc:familyName a rdf:Property;
    rdfs:domain <Person>;
    rdfs:range xs:string .

sc:email a rdf:Property;
    rdfs:domain <Person>;
    rdfs:range xs:string .