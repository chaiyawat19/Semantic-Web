#################################################################

###  http://www.sport.com#Badminton
sp:Badminton rdf:type owl:NamedIndividual .


###  http://www.sport.com#Basketball
sp:Basketball rdf:type owl:NamedIndividual .


###  http://www.sport.com#Bob
sp:Bob rdf:type owl:NamedIndividual ,
                sp:AllPeople ;
       sp:hasFavor sp:Jogging .


