@prefix : <http://www.semanticweb.org/imseb/ontologies/2026/1/untitled-ontology-9/> .
@prefix sp: <http://www.sport.com#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/imseb/ontologies/2026/1/untitled-ontology-9/> .

<http://www.semanticweb.org/imseb/ontologies/2026/1/untitled-ontology-9> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://www.sport.com#hasFavor
sp:hasFavor rdf:type owl:ObjectProperty ;
            rdfs:domain sp:AllPeople ;
            rdfs:range sp:Sport .


#################################################################
#    Classes
#################################################################

###  http://www.sport.com#AllPeople
sp:AllPeople rdf:type owl:Class .


###  http://www.sport.com#FavorSport1
sp:FavorSport1 rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Class ;
                                     owl:oneOf ( sp:Badminton
                                                 sp:Basketball
                                                 sp:Running
                                                 sp:Swimming
                                                 sp:Yoga
                                               )
                                   ] ;
               rdfs:subClassOf sp:Sport .


###  http://www.sport.com#FavorSport2
sp:FavorSport2 rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Class ;
                                     owl:oneOf ( sp:Badminton
                                                 sp:Jogging
                                                 sp:Swimming
                                                 sp:Tennis
                                                 sp:Yoga
                                               )
                                   ] ;
               rdfs:subClassOf sp:Sport .


###  http://www.sport.com#GroupPeople1
sp:GroupPeople1 rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty sp:hasFavor ;
                                      owl:someValuesFrom sp:FavorSport1
                                    ] ;
                rdfs:subClassOf sp:AllPeople .


###  http://www.sport.com#GroupPeople2
sp:GroupPeople2 rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty sp:hasFavor ;
                                      owl:someValuesFrom sp:FavorSport2
                                    ] ;
                rdfs:subClassOf sp:AllPeople .


###  http://www.sport.com#GroupPeople3
sp:GroupPeople3 rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty sp:hasFavor ;
                                      owl:someValuesFrom sp:SameSport
                                    ] ;
                rdfs:subClassOf sp:AllPeople .


###  http://www.sport.com#SameSport
sp:SameSport rdf:type owl:Class ;
             owl:equivalentClass [ owl:intersectionOf ( sp:FavorSport1
                                                        sp:FavorSport2
                                                      ) ;
                                   rdf:type owl:Class
                                 ] .


###  http://www.sport.com#Sport
sp:Sport rdf:type owl:Class .


